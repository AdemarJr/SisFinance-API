# EasyPanel → apps-pyrou → sisfinance-api → Environment
#
# Build: Dockerfile (raiz do repo SisFinance-API)
# Porta do container: 3001 (mapear no domínio do serviço)
# Health: /api/health

NODE_ENV=production
PORT=3001
JWT_SECRET=troque-por-um-segredo-longo-aleatorio

# Postgres EasyPanel — preferir PG* (senha com @ * ! sem URL-encode)
# Se a API e o Postgres estão no MESMO projeto, use o host interno:
#   PGHOST=<projeto>_<servico-postgres>
# Ex.: apps-pyrou_pyroudb
# Caso contrário (Postgres exposto):
PGHOST=easypanel.pyrou.com.br
PGPORT=5432
PGDATABASE=pyrou-finace
PGUSER=pyrouwebdb
PGPASSWORD=sua-senha-literal
PGSSLMODE=disable

# Opcional — só após import do dump:
# ADMIN_EMAIL=admin@sisfinance.com
# ADMIN_PASSWORD=defina-uma-senha-forte
